<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상. 로그인 세션 파일만 클라우드 백업 · 기기 이전에서 뺀다. 새 폰에서는 다시 로그인한다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/stepup_auth.preferences_pb" />
        <!-- 알림 링크 비밀 값(LinkToken) — 설치마다 새로 만든다. 다른 폰으로 옮기지 않는다(2026-11-24 보안 점검) -->
        <exclude domain="sharedpref" path="stepup_link_token.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/stepup_auth.preferences_pb" />
        <!-- 알림 링크 비밀 값(LinkToken) — 설치마다 새로 만든다. 다른 폰으로 옮기지 않는다(2026-11-24 보안 점검) -->
        <exclude domain="sharedpref" path="stepup_link_token.xml" />
    </device-transfer>
</data-extraction-rules>
