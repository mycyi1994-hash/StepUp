<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 시스템 시작 화면은 인트로 영상 첫 장면과 같은 어두운 색(두 테마 모두) — 영상으로 넘어갈 때 번쩍이지 않게 -->
    <style name="Theme.StepUp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowSplashScreenBackground">@color/launch_ground</item>
    </style>
</resources>
