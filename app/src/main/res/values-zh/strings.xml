    <!-- Support -->
    <string name="support_faq">常见问题</string>
    <string name="faq_q_earn">怎么赚 SUP？</string>
    <string name="faq_a_earn">在首页开始一次跑步。只有跑步过程中记录到的步数才能赚 SUP，倍率取决于你的球鞋和生效中的加成。</string>
    <string name="faq_q_energy">为什么不赚 SUP 了？</string>
    <string name="faq_a_energy">能量用完了。1 点能量对应 600 步，每天午夜会自动回满。</string>
    <string name="faq_q_rarity">稀有度是怎么运作的？</string>
    <string name="faq_a_rarity">稀有度决定属性上限和最高等级。装备球鞋的幸运越高，铸造时开出好货的概率就越大。</string>
    <string name="faq_q_withdraw">什么时候能提现？</string>
    <string name="faq_a_withdraw">转到 GIWA 链的链上功能还在开发中。在那之前，你的余额都很安全。</string>
    <string name="support_contact">联系我们</string>
    <string name="support_contact_body">有问题或想报 bug，欢迎到项目仓库找我们。</string>

