# StepUp 서버 작업이 쓰는 환경 변수 — **값은 비워 둔다.**
#
# 이 파일은 "무엇이 필요한지"만 알려 주는 견본이다. 실제 값은 여기 적지 않고
# GitHub 저장소의 Settings → Secrets and variables → Actions 에 넣는다.
# 로컬에서 돌려 볼 때는 이 파일을 .env 로 복사해 채우되, .env 는 커밋하지 않는다.

# ── Supabase ────────────────────────────────────────────────────────
# 프로젝트 주소. 대시보드 Settings → API 의 Project URL.
SUPABASE_URL=

# service_role 키. RLS 를 지나가므로 표 전체를 고칠 수 있다.
# 수집기(GitHub Actions)만 쓴다. 앱에는 절대 넣지 않는다.
SUPABASE_SERVICE_KEY=

# ── 네이버 뉴스 검색 API ────────────────────────────────────────────
# https://developers.naver.com/ 에서 애플리케이션을 만들고 "검색" API 를
# 추가하면 나오는 두 값.
#
# 이 키가 없으면 뉴스 수집기는 아무것도 가져오지 않고 끝난다. 그것이
# 정상 동작이다 — 뉴스 탭은 "새 소식을 준비하고 있어요"를 보여 준다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
