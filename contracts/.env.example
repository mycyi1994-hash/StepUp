# ─────────────────────────────────────────────────────────────────────
#  이 파일을 .env 로 복사해서 값을 채우세요.  cp .env.example .env
#
#  ⚠️  .env 는 .gitignore 에 있습니다. 절대 커밋하지 마세요.
#  ⚠️  개인키는 누구에게도(채팅·이메일·이슈 포함) 보내지 마세요.
#  ⚠️  테스트넷 배포 전용 지갑을 새로 만들어 쓰세요.
#      실제 자산이 든 지갑의 키를 여기에 넣지 마세요.
# ─────────────────────────────────────────────────────────────────────

# 배포 계정 개인키 (0x 접두사 포함)
DEPLOYER_PRIVATE_KEY=0x여기에_테스트넷_전용_개인키

# ── 역할 주소 (v2 실제 배포에서는 전부 필수, 배포 계정과 달라야 함) ──────
# 드라이런(--network hardhat)에서는 비워 두면 배포 계정이 겸합니다.
# 여기에는 **주소만** 넣습니다. 이 키들의 개인키는 이 파일에 넣지 않습니다.

# 관리자 — 배포 뒤 이 지갑에서 acceptOwnership() 을 눌러야 소유권이 넘어갑니다
# OWNER_ADDRESS=0x...
# 금고 — 10억 SUP 를 받고 보상 풀을 채웁니다
# TREASURY_ADDRESS=0x...
# SUP 꺼내기 서명 (Cloudflare 비밀)
# ATTESTER_ADDRESS=0x...
# 신발 발행 · 반환 서명 (Cloudflare 비밀)
# SNEAKER_SIGNER_ADDRESS=0x...
# 긴급 정지 전용 (Cloudflare 비밀) — 정지만 할 수 있고 재개는 관리자만
# GUARDIAN_ADDRESS=0x...
# 코스 완주 기록 (Cloudflare 비밀)
# RECORDER_ADDRESS=0x...

# 신발 메타데이터 IPFS 베이스 URI (끝에 / 필요) — 실제 배포에서 필수
# SNEAKER_BASE_URI=ipfs://bafy.../

# 한도 (기본값: 풀 5천만 · 하루 5만 · 1회 1천 SUP · 하루 발행 2,500)
# POOL_AMOUNT=50000000
# DAILY_CAP=50000
# MAX_CLAIM=1000
# MAX_MINTS_PER_DAY=2500

# ── 네트워크 ─────────────────────────────────────────────────────────
# 기본값이 이미 들어 있어 보통 손댈 필요가 없습니다.
# GIWA_SEPOLIA_RPC=https://sepolia-rpc.giwa.io

# GIWA 메인넷은 준비 중입니다. 공개되면 여기에 넣으면 그대로 동작합니다.
# GIWA_MAINNET_RPC=
# GIWA_MAINNET_EXPLORER=https://explorer.giwa.io

# GIWA 익스플로러는 Blockscout이라 API 키가 필요 없습니다.
# GIWA_EXPLORER_API_KEY=blockscout
