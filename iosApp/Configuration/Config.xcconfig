// iOS 앱 식별 값 — docs/APP-STORE.md "0. 먼저 해 둘 것".
// BUNDLE_ID 는 App Store Connect 에 처음 올린 뒤로는 바꿀 수 없다. 사용자가 확정하기 전까지 아래는 임시 값이다.
BUNDLE_ID = com.stepupcrew.stepup
// Apple Developer › Membership 의 Team ID(10자리). 비워 두면 시뮬레이터 빌드만 된다(실기기 · TestFlight 는 이 값이 있어야 한다).
TEAM_ID =

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// 구글 로그인(iOS) — Google Cloud › 사용자 인증 정보 › OAuth 클라이언트 ID(유형 iOS, 번들 ID 위와 같게)를 만들어 채운다.
// URL_SCHEME 은 클라이언트 ID 를 거꾸로 쓴 값(com.googleusercontent.apps.…). 비워 두면 구글 버튼은 "준비되지 않음"으로 답한다.
// Supabase › Authentication › Google 의 Client IDs 에도 이 iOS 클라이언트 ID 를 더한다(docs/APP-STORE.md).
GOOGLE_IOS_CLIENT_ID =
GOOGLE_IOS_URL_SCHEME = com.stepupcrew.stepup.google-unset

// 서버(Supabase) 주소 · 공개 키 — 앱에 들어가도 되는 값만(sb_publishable). 안드로이드 BuildConfig 와 같은 서버.
// xcconfig 에서 // 는 주석이라 주소의 // 를 $(SLASH) 로 잇는다.
SLASH = /
STEPUP_SUPABASE_URL = https:$(SLASH)$(SLASH)pupjzcmybuoyhzfwrsdf.supabase.co
STEPUP_SUPABASE_KEY = sb_publishable_jt74AKM32zdqnJlsFHEo2g_MNHa-WRO
// 어테스터 워커(Apple 토큰 철회 · 러닝 증명) — 비우면 철회를 건너뛴다
STEPUP_ATTESTER_URL =
// 지도 타일(MapTiler) 공개 키 — 안드로이드 app/build.gradle.kts 의 기본 키와 같다(앱에 넣으라고 발급되는 키, 도메인 · 앱 제한은 MapTiler 대시보드).
STEPUP_MAPTILER_KEY = Tsagjrb4rNikrZug4jBG
