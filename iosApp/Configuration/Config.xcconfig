// iOS 앱 식별 값 — docs/APP-STORE.md "0. 먼저 해 둘 것".
// BUNDLE_ID 는 App Store Connect 에 처음 올린 뒤로는 바꿀 수 없다. 사용자가 확정하기 전까지 아래는 임시 값이다.
BUNDLE_ID = com.stepupcrew.stepup
