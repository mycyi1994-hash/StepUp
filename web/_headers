# 안드로이드가 앱 링크를 확인할 때 읽는 파일. JSON 으로, 다른 곳으로 넘기지 않고 준다.
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# 지갑 페이지 — 로그인 토큰을 다루므로 다른 사이트에 끼워 넣지 못하게 하고,
# 주소(#토큰)가 다른 곳으로 새지 않게 한다. 스크립트는 이 사이트 것만.
/wallet*
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

# 지갑 페이지 스크립트 — 파일 이름이 늘 같으므로, 고친 것이 바로 닿게 매번 새로 확인한다
/assets/wallet.js
  Cache-Control: no-cache

